# Configuration des projets : port du reverse proxy et tag d'image de
# chaque site. Ce fichier est versionné (pas de secrets ici).
#
# Les hosts routés sont définis dans reverse-proxy/conf.d/ (un fichier
# de conf nginx par application).

# Port d'écoute du reverse proxy nginx (seul point d'entrée).
NGINX_PORT=80

# Mot de passe de la base Fidexil : à définir sur le serveur (variable
# d'environnement ou ligne ajoutée localement — ne pas commiter la vraie
# valeur, ce fichier est versionné). Défaut : "changeme".
FIDEXIL_DB_PASSWORD=fidexil123

# Base Hi-Tech Academy (demandes d'inscription) : même principe, définir
# la vraie valeur sur le serveur uniquement. Défaut : "changeme".
HI_TECH_ACADEMY_DB_PASSWORD=hitech123
# Accès admin de hi-tech-academy.fr/admin : surcharger sur le serveur.
# HI_TECH_ACADEMY_ADMIN_EMAIL=me.chekini@gmail.com
# HI_TECH_ACADEMY_ADMIN_PASSWORD=test
