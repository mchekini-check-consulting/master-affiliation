---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import QuizSession from '../../../components/QuizSession.astro';
import type { QuizQuestion } from '../../../components/QuizSession.astro';
import { categories } from '../../../data/categories';

// Un thème de quiz = une catégorie du programme (Java, Spring, Git…).
// Chaque fichier src/data/quiz/<slug>.json correspond à la fiche du même
// slug ; on retrouve sa catégorie via la collection de fiches.
const fiches = await getCollection('fiches');
const categorieParSlug = new Map(
  fiches.map((f) => [f.id.split('/').pop(), f.data.categorie])
);

const quizModules = import.meta.glob<{ questions: any[] }>(
  '../../../data/quiz/*.json',
  { eager: true }
);

const allQuestions: QuizQuestion[] = [];
Object.entries(quizModules).forEach(([path, module]) => {
  const slug = path.split('/').pop()?.replace('.json', '') || '';
  const theme = categorieParSlug.get(slug);
  if (!theme) return; // quiz orphelin : pas de fiche correspondante
  (module.questions || []).forEach((q, i) => {
    allQuestions.push({
      id: `${slug}-${i}`,
      theme,
      code: q.code || null,
      lang: q.lang || null,
      question: q.question,
      options: q.options,
      reponse: q.reponse,
      explication: q.explication,
    });
  });
});

const themes = categories.map((c) => ({
  id: c.slug,
  label: c.label,
  description: c.description,
}));
---

<Layout
  title="Quiz personnalisé — Dév Full Stack | Prépa Technique"
  description="Créez votre propre quiz en sélectionnant les thèmes que vous souhaitez réviser. Questions à choix multiple, résultats instantanés."
>
  <main class="page">
    <nav class="retour" aria-label="Fil d'Ariane">
      <a href="/fullstack/">← Retour à la préparation Dév Full Stack</a>
    </nav>

    <header class="hero">
      <h1>Quiz personnalisé</h1>
      <p class="hero-sous">
        Choisissez les thèmes que vous souhaitez réviser et lancez une session
        de QCM. Vous aurez les réponses et les explications à chaque question.
      </p>
    </header>

    <QuizSession themes={themes} questions={allQuestions} preparation="fullstack" />

    <section class="info-section">
      <h2>Comment ça marche</h2>
      <ol>
        <li>
          <strong>Sélectionnez des thèmes</strong> – Choisissez parmi Java,
          Spring, Git, DevOps, etc.
        </li>
        <li>
          <strong>Lancez le quiz</strong> – Les questions s'enchaînent une par
          une
        </li>
        <li>
          <strong>Recevez un feedback immédiat</strong> – Explication après
          chaque réponse
        </li>
        <li>
          <strong>Consultez votre score</strong> – Global et par thème
        </li>
      </ol>
      <p class="info-note">
        Vous pouvez recommencer autant de fois que vous le souhaitez. Les quiz
        sont générés dynamiquement à partir des fiches.
      </p>
    </section>
  </main>
</Layout>

<style>
  .page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 5vw, 3rem) 5rem;
  }

  .retour {
    margin-bottom: 2rem;
  }

  .retour a {
    font-family: var(--f-display);
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--estompe);
    text-decoration: none;
  }

  .retour a:hover {
    color: var(--bic);
  }

  .hero {
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 780;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .hero-sous {
    font-size: 1.125rem;
    color: var(--estompe);
    margin: 0;
    max-width: 36rem;
  }

  .info-section {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--blanc);
    border: 1px solid var(--trait);
    border-radius: 12px;
  }

  .info-section h2 {
    font-size: 1.375rem;
    font-weight: 750;
    margin: 0 0 1rem;
  }

  .info-section ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .info-section li {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .info-section strong {
    color: var(--bic);
  }

  .info-note {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--bic-doux);
    border-left: 3px solid var(--bic);
    border-radius: 0 8px 8px 0;
    font-size: 0.9375rem;
    color: var(--encre);
  }

  @media (max-width: 900px) {
    .page {
      padding: 2rem 1.25rem 3rem;
    }
  }
</style>
