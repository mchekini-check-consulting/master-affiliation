---
// Page de la préparation DevOps. Trois onglets : les fiches par thématique,
// les questions d'entretien (dont situationnel), et le quiz.
import Layout from '../../layouts/Layout.astro';
import OngletThemes from '../../components/devops/OngletThemes.astro';
import OngletQuestions from '../../components/devops/OngletQuestions.astro';
import OngletQuiz from '../../components/devops/OngletQuiz.astro';
import questions from '../../data/devops/questions.json';
import quiz from '../../data/devops/quiz.json';

const nbQuestions = questions.sections.reduce(
  (n, s) => n + s.questions.length,
  0
);
const nbQuiz = quiz.themes.reduce((n, t) => n + t.questions.length, 0);

const onglets = [
  { id: 'themes', label: 'Thématiques', sous: '12 fiches par sujet' },
  {
    id: 'questions',
    label: 'Questions',
    sous: `${nbQuestions} questions + situationnel`,
  },
  { id: 'quiz', label: 'Quiz', sous: `${nbQuiz} QCM corrigés` },
];
---

<Layout
  title="Préparation DevOps — Prépa Technique"
  description={`La préparation DevOps : fiches par thématique (Terraform, CI/CD, Kubernetes, ArgoCD, Kyverno, Istio, observabilité, cloud AWS/Azure, Ansible, IA & MLOps), ${nbQuestions} questions d'entretien avec cas situationnels réels, et ${nbQuiz} QCM corrigés.`}
>
  <main class="devops">
    <nav class="retour" aria-label="Fil d'Ariane">
      <a href="/">← Toutes les préparations</a>
    </nav>

    <header class="entete">
      <p class="eyebrow">Préparation</p>
      <h1>DevOps <span class="marque">& Cloud</span></h1>
      <p class="sous">
        De Terraform à l'IA : les fiches par thématique, les questions
        d'entretien avec leurs réponses — y compris les cas situationnels vécus
        — et un quiz pour se tester sur chaque sujet.
      </p>
    </header>

    <div class="onglets" role="tablist" aria-label="Sections de la préparation">
      {
        onglets.map((o, i) => (
          <button
            class="onglet"
            role="tab"
            id={`tab-${o.id}`}
            aria-controls={`panel-${o.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-onglet={o.id}
          >
            <span class="onglet-label">{o.label}</span>
            <span class="onglet-sous">{o.sous}</span>
          </button>
        ))
      }
    </div>

    <section
      id="panel-themes"
      role="tabpanel"
      aria-labelledby="tab-themes"
      class="panneau"
    >
      <OngletThemes />
    </section>
    <section
      id="panel-questions"
      role="tabpanel"
      aria-labelledby="tab-questions"
      class="panneau"
      hidden
    >
      <OngletQuestions />
    </section>
    <section
      id="panel-quiz"
      role="tabpanel"
      aria-labelledby="tab-quiz"
      class="panneau"
      hidden
    >
      <OngletQuiz />
    </section>
  </main>
</Layout>

<script>
  // Bascule d'onglets synchronisée avec le hash (#themes, #questions, #quiz)
  const boutons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.onglet')
  );
  const panneaux = new Map(
    boutons.map((b) => [
      b.dataset.onglet!,
      document.getElementById(`panel-${b.dataset.onglet}`)!,
    ])
  );

  function activer(id: string, pousserHash = true) {
    if (!panneaux.has(id)) id = 'themes';
    for (const b of boutons) {
      const actif = b.dataset.onglet === id;
      b.setAttribute('aria-selected', actif ? 'true' : 'false');
      panneaux.get(b.dataset.onglet!)!.hidden = !actif;
    }
    if (pousserHash) history.replaceState(null, '', `#${id}`);
  }

  boutons.forEach((b) =>
    b.addEventListener('click', () => activer(b.dataset.onglet!))
  );
  window.addEventListener('hashchange', () =>
    activer(location.hash.slice(1), false)
  );
  if (location.hash) activer(location.hash.slice(1), false);
</script>

<style>
  .devops {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 4vw, 3rem) 5rem;
  }

  .retour {
    margin-bottom: 2rem;
  }

  .retour a {
    font-family: var(--f-display);
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--estompe);
    text-decoration: none;
  }

  .retour a:hover {
    color: var(--bic);
  }

  .eyebrow {
    font-family: var(--f-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bic);
    margin: 0 0 0.5rem;
  }

  .entete h1 {
    font-size: clamp(2rem, 4.5vw, 2.9rem);
    font-weight: 780;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .sous {
    font-size: 1.125rem;
    color: var(--estompe);
    max-width: 44rem;
    margin: 0 0 2.25rem;
  }

  .onglets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  .onglet {
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.7rem 0.9rem;
    background: var(--blanc);
    border: 1px solid var(--trait);
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--f-display);
    color: var(--encre);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .onglet:hover {
    border-color: var(--bic);
    transform: translateY(-1px);
  }

  .onglet[aria-selected='true'] {
    border-color: var(--bic);
    box-shadow: inset 0 -3px 0 var(--surligneur), 0 6px 16px rgba(25, 29, 43, 0.07);
  }

  .onglet-label {
    font-weight: 750;
    font-size: 0.9375rem;
  }

  .onglet[aria-selected='true'] .onglet-label {
    color: var(--bic);
  }

  .onglet-sous {
    font-size: 0.6875rem;
    color: var(--estompe);
  }

  .panneau {
    animation: apparait 0.25s ease;
  }

  @keyframes apparait {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 700px) {
    .onglets {
      grid-template-columns: 1fr;
    }
    .onglet-sous {
      display: none;
    }
  }
</style>
