---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { preparations } from '../data/preparations';
import { modes } from '../data/modes';

const fiches = await getCollection('fiches');
const total = fiches.length;

// Chiffres affichés sur la carte de la préparation disponible (Full Stack)
const compteParPrepa: Record<string, string> = {
  fullstack: `${total} fiches · 7 matières · quiz à chaque fiche`,
};
---

<Layout
  title="Prépa Technique — Choisissez votre préparation d'entretien"
  description="Le cahier de révision des entretiens tech : préparations Dév Full Stack, Business Analyst, QA et DevOps — fiches corrigées au stylo, quiz, simulation d'entretien et Codingame."
>
  <main class="accueil">
    <header class="hero">
      <p class="logo">
        <span class="logo-titre">Prépa Technique</span>
        <span class="logo-sous">Le cahier de révision des entretiens</span>
      </p>
      <h1>
        Choisissez votre
        <span class="marque marque--animee">préparation</span>
      </h1>
      <p class="hero-sous">
        Un cahier de révision corrigé au stylo pour chaque métier de la tech.
        Choisissez votre voie, puis révisez fiche après fiche — l'interro est
        comprise.
      </p>
    </header>

    <section class="bloc" aria-label="Les préparations">
      <h2 class="bloc-titre">Les préparations</h2>
      <div class="prepas">
        {
          preparations.map((p) => (
            <a
              class={`prepa${p.disponible ? '' : ' prepa--bientot'}`}
              href={`/${p.slug}/`}
            >
              <span
                class={`etat ${p.disponible ? 'etat--dispo' : 'etat--bientot'}`}
              >
                {p.disponible ? 'Disponible' : 'En préparation'}
              </span>
              <h3>{p.label}</h3>
              <p class="prepa-desc">{p.description}</p>
              <p class="prepa-matieres">{p.matieres}</p>
              {compteParPrepa[p.slug] && (
                <p class="prepa-compte">{compteParPrepa[p.slug]}</p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <section class="bloc" aria-label="Les modes d'entraînement">
      <h2 class="bloc-titre">Les modes d'entraînement</h2>
      <p class="bloc-sous">
        Chaque préparation se travaillera bientôt de plusieurs façons — et les
        nouveaux modes toucheront d'autres thématiques.
      </p>
      <div class="modes">
        {
          modes.map((m) => {
            const Carte = m.lien ? 'a' : 'article';
            return (
              <Carte
                class={`mode${m.lien ? ' mode--lien' : ''}`}
                href={m.lien}
              >
                <span
                  class={`etat ${m.disponible ? 'etat--dispo' : 'etat--bientot'}`}
                >
                  {m.disponible ? 'Disponible' : 'À venir'}
                  {m.precision && ` · ${m.precision}`}
                </span>
                <h3>{m.label}</h3>
                <p>{m.description}</p>
              </Carte>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .accueil {
    max-width: 62rem;
    margin: 0 auto;
    padding: 3.5rem clamp(1.25rem, 5vw, 3rem) 5rem;
  }

  /* ---------- En-tête ---------- */
  .logo {
    margin: 0 0 2.5rem;
  }

  .logo-titre {
    display: block;
    font-family: var(--f-display);
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .logo-titre::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 5px;
    margin-top: 2px;
    background: var(--surligneur);
    border-radius: 2px;
    transform: rotate(-1.5deg);
  }

  .logo-sous {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--f-display);
    font-size: 0.75rem;
    color: var(--estompe);
  }

  .hero {
    max-width: 44rem;
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    font-weight: 780;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  /* Coup de surligneur sur le mot-clé au chargement */
  .marque--animee {
    background-size: 0% 100%;
    background-repeat: no-repeat;
    animation: surligner 0.7s ease-out 0.35s forwards;
  }

  @keyframes surligner {
    to {
      background-size: 100% 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marque--animee {
      background-size: 100% 100%;
      animation: none;
    }
  }

  .hero-sous {
    font-size: 1.1875rem;
    color: var(--estompe);
    margin: 0;
    max-width: 36rem;
  }

  /* ---------- Sections ---------- */
  .bloc {
    margin-bottom: 3.5rem;
  }

  .bloc-titre {
    font-size: 1.375rem;
    font-weight: 750;
    margin: 0 0 1rem;
  }

  .bloc-sous {
    font-family: var(--f-display);
    font-size: 0.875rem;
    color: var(--estompe);
    margin: -0.5rem 0 1rem;
    max-width: 40rem;
  }

  /* ---------- Étiquette d'état (tampon) ---------- */
  .etat {
    justify-self: start;
    align-self: start;
    font-family: var(--f-display);
    font-size: 0.6875rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    transform: rotate(-1.5deg);
  }

  .etat--dispo {
    color: var(--vert);
    background: var(--vert-doux);
    border: 1.5px solid currentColor;
  }

  .etat--bientot {
    color: var(--estompe);
    background: var(--blanc);
    border: 1.5px dashed currentColor;
  }

  /* ---------- Cartes des préparations ---------- */
  .prepas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .prepa {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--blanc);
    border: 1px solid var(--trait);
    border-radius: 12px;
    text-decoration: none;
    color: var(--encre);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .prepa:hover {
    border-color: var(--bic);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(25, 29, 43, 0.08);
  }

  .prepa h3 {
    font-size: 1.125rem;
    font-weight: 750;
    margin: 0;
  }

  .prepa:hover h3 {
    color: var(--bic);
  }

  .prepa-desc {
    font-family: var(--f-display);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--estompe);
    margin: 0;
  }

  .prepa-matieres {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--bic);
    margin: 0;
  }

  .prepa--bientot .prepa-matieres {
    color: var(--estompe);
    font-style: italic;
  }

  .prepa-compte {
    font-family: var(--f-display);
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--encre);
    margin: 0;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--trait);
  }

  /* ---------- Cartes des modes ---------- */
  .modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .mode {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--blanc);
    border: 1px solid var(--trait);
    border-radius: 12px;
  }

  .mode h3 {
    font-size: 1.0625rem;
    font-weight: 750;
    margin: 0;
  }

  .mode p {
    font-family: var(--f-display);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--estompe);
    margin: 0;
  }

  .mode--lien {
    text-decoration: none;
    color: var(--encre);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .mode--lien:hover {
    border-color: var(--bic);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(25, 29, 43, 0.08);
  }

  .mode--lien:hover h3 {
    color: var(--bic);
  }

  @media (max-width: 700px) {
    .prepas,
    .modes {
      grid-template-columns: 1fr;
    }
  }
</style>
