<script>
  // Calculateur de franchise
  const frCout = document.getElementById('fr-cout') as HTMLInputElement;
  const frFranchise = document.getElementById('fr-franchise') as HTMLInputElement;
  function majFranchise() {
    const cout = +frCout.value;
    const franchise = +frFranchise.value;
    const assureur = Math.max(0, cout - franchise);
    const assure = Math.min(cout, franchise);
    document.getElementById('fr-cout-out')!.textContent = cout.toLocaleString('fr-FR');
    document.getElementById('fr-franchise-out')!.textContent = franchise.toLocaleString('fr-FR');
    document.getElementById('fr-resultat')!.innerHTML =
      `L'assureur rembourse <strong>${assureur.toLocaleString('fr-FR')} €</strong> · ` +
      `l'assuré paie <strong>${assure.toLocaleString('fr-FR')} €</strong>` +
      (franchise >= cout ? ' — sinistre entièrement sous franchise !' : '');
  }
  frCout.addEventListener('input', majFranchise);
  frFranchise.addEventListener('input', majFranchise);
  majFranchise();

  // Calculateur S/P
  const spPrimes = document.getElementById('sp-primes') as HTMLInputElement;
  const spSinistres = document.getElementById('sp-sinistres') as HTMLInputElement;
  function majSP() {
    const p = +spPrimes.value;
    const s = +spSinistres.value;
    const ratio = Math.round((s / p) * 100);
    document.getElementById('sp-primes-out')!.textContent = String(p);
    document.getElementById('sp-sinistres-out')!.textContent = String(s);
    const el = document.getElementById('sp-resultat')!;
    el.innerHTML = `S/P = <strong>${ratio} %</strong> — ${
      ratio < 100
        ? '✅ portefeuille rentable'
        : "❌ l'assureur perd de l'argent sur ce segment"
    }`;
    el.style.color = ratio < 100 ? 'var(--vert)' : 'var(--rouge)';
  }
  spPrimes.addEventListener('input', majSP);
  spSinistres.addEventListener('input', majSP);
  majSP();

  // Liens internes vers d'autres onglets
  document.querySelectorAll<HTMLAnchorElement>('.lien-onglet').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      (
        document.querySelector(
          `.onglet[data-onglet="${a.dataset.cible}"]`
        ) as HTMLButtonElement
      )?.click();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    })
  );
</script>

