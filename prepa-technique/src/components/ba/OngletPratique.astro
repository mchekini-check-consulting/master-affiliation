  const SCHEMA: Record<string, string[]> = {
    clients: ['id_client', 'nom', 'prenom', 'date_naissance', 'ville', 'code_postal'],
    contrats: ['id_contrat', 'num_contrat', 'id_client', 'produit', 'statut', 'date_effet', 'date_resiliation', 'prime_annuelle', 'bonus_malus'],
    garanties: ['id_garantie', 'code', 'libelle', 'produit'],
    contrat_garanties: ['id_contrat', 'id_garantie', 'plafond', 'franchise'],
    sinistres: ['id_sinistre', 'num_sinistre', 'id_contrat', 'id_garantie', 'type_sinistre', 'date_survenance', 'date_declaration', 'statut', 'montant_estime', 'montant_regle'],
    quittances: ['id_quittance', 'id_contrat', 'periode_debut', 'periode_fin', 'montant', 'statut', 'date_paiement'],
  };

  // ---------------------------------------------------------------
  // Exercices
  // ---------------------------------------------------------------
  interface Exo {
    titre: string;
    niveau: 1 | 2 | 3;
    enonce: string;
    indice: string;
    solution: string;
    ordre?: boolean; // true si l'ordre des lignes fait partie de l'attendu
  }

  const EXOS: Exo[] = [
    {
      titre: 'Tous les clients',
      niveau: 1,
      enonce: 'Affichez toutes les colonnes de tous les clients.',
      indice: 'SELECT * FROM … — la requête la plus simple qui existe.',
      solution: 'SELECT * FROM clients;',
    },
    {
      titre: 'Contrats actifs',
      niveau: 1,
      enonce: "Listez le numéro de contrat, le produit et la prime annuelle des contrats au statut 'ACTIF'.",
      indice: "Un WHERE sur la colonne statut. Les chaînes s'écrivent entre apostrophes : 'ACTIF'.",
      solution: "SELECT num_contrat, produit, prime_annuelle FROM contrats WHERE statut = 'ACTIF';",
    },
    {
      titre: 'Top 5 des primes',
      niveau: 1,
      enonce: 'Les 5 contrats les plus chers : numéro de contrat et prime annuelle, du plus cher au moins cher.',
      indice: 'ORDER BY … DESC puis LIMIT 5.',
      solution: 'SELECT num_contrat, prime_annuelle FROM contrats ORDER BY prime_annuelle DESC LIMIT 5;',
      ordre: true,
    },
    {
      titre: 'Contrats par produit',
      niveau: 1,
      enonce: 'Comptez le nombre de contrats par produit (colonnes : produit, nb_contrats).',
      indice: 'COUNT(*) avec un GROUP BY produit.',
      solution: 'SELECT produit, COUNT(*) AS nb_contrats FROM contrats GROUP BY produit;',
    },
    {
      titre: 'Prime moyenne des contrats actifs',
      niveau: 2,
      enonce: "Par produit, la prime annuelle moyenne des seuls contrats actifs (la question classique d'entretien !).",
      indice: 'Le WHERE filtre les lignes AVANT le regroupement : WHERE statut = … puis GROUP BY.',
      solution: "SELECT produit, AVG(prime_annuelle) AS prime_moyenne FROM contrats WHERE statut = 'ACTIF' GROUP BY produit;",
    },
    {
      titre: 'Sinistres avec contrat et client',
      niveau: 2,
      enonce: 'Pour chaque sinistre : son numéro, le numéro de contrat et le nom du client. Trois tables à relier.',
      indice: 'sinistres JOIN contrats ON id_contrat, puis JOIN clients ON id_client.',
      solution:
        'SELECT s.num_sinistre, c.num_contrat, cl.nom FROM sinistres s JOIN contrats c ON s.id_contrat = c.id_contrat JOIN clients cl ON c.id_client = cl.id_client;',
    },
    {
      titre: 'Contrats sans sinistre',
      niveau: 2,
      enonce: "Listez les numéros des contrats qui n'ont jamais eu de sinistre.",
      indice: 'LEFT JOIN sinistres … puis WHERE s.id_sinistre IS NULL. (Un NOT IN fonctionne aussi.)',
      solution:
        'SELECT c.num_contrat FROM contrats c LEFT JOIN sinistres s ON s.id_contrat = c.id_contrat WHERE s.id_sinistre IS NULL;',
    },
    {
      titre: 'Nombre de sinistres par contrat (0 inclus)',
      niveau: 2,
      enonce: 'Pour chaque contrat : numéro de contrat et nombre de sinistres — y compris 0 pour les contrats jamais sinistrés.',
      indice: "LEFT JOIN + COUNT(s.id_sinistre) : COUNT sur une colonne ignore les NULL, donc compte 0 pour les contrats sans sinistre. Un COUNT(*) compterait 1 — c'est le piège.",
      solution:
        'SELECT c.num_contrat, COUNT(s.id_sinistre) AS nb_sinistres FROM contrats c LEFT JOIN sinistres s ON s.id_contrat = c.id_contrat GROUP BY c.id_contrat, c.num_contrat;',
    },
    {
      titre: 'Produits chers (HAVING)',
      niveau: 2,
      enonce: 'Les produits dont la prime annuelle moyenne (tous statuts) dépasse 600 € — avec cette moyenne.',
      indice: 'On filtre un agrégat → HAVING AVG(…) > 600, pas WHERE.',
      solution:
        'SELECT produit, AVG(prime_annuelle) AS prime_moyenne FROM contrats GROUP BY produit HAVING AVG(prime_annuelle) > 600;',
    },
    {
      titre: 'Quittances impayées',
      niveau: 2,
      enonce: 'Les quittances impayées avec le numéro de contrat, le nom du client et le montant dû.',
      indice: "quittances JOIN contrats JOIN clients, WHERE q.statut = 'IMPAYEE'.",
      solution:
        "SELECT c.num_contrat, cl.nom, q.montant FROM quittances q JOIN contrats c ON q.id_contrat = c.id_contrat JOIN clients cl ON c.id_client = cl.id_client WHERE q.statut = 'IMPAYEE';",
    },
    {
      titre: 'Montant réglé par type de sinistre',
      niveau: 3,
      enonce: "Pour les sinistres clos, le montant total réglé par type de sinistre, trié du plus coûteux au moins coûteux.",
      indice: "WHERE statut = 'CLOS', SUM(montant_regle), GROUP BY type_sinistre, ORDER BY … DESC.",
      solution:
        "SELECT type_sinistre, SUM(montant_regle) AS total_regle FROM sinistres WHERE statut = 'CLOS' GROUP BY type_sinistre ORDER BY total_regle DESC;",
      ordre: true,
    },
    {
      titre: 'Clients multi-contrats actifs',
      niveau: 3,
      enonce: "Les clients (nom, prénom) qui détiennent plus d'un contrat actif, avec le nombre de contrats.",
      indice: 'JOIN + WHERE sur le statut + GROUP BY client + HAVING COUNT(*) > 1.',
      solution:
        "SELECT cl.nom, cl.prenom, COUNT(*) AS nb_contrats FROM clients cl JOIN contrats c ON c.id_client = cl.id_client WHERE c.statut = 'ACTIF' GROUP BY cl.id_client, cl.nom, cl.prenom HAVING COUNT(*) > 1;",
    },
    {
      titre: 'Ratio S/P par produit',
      niveau: 3,
      enonce:
        "Le grand classique du pilotage : par produit, le total des primes des contrats, le total des sinistres réglés, et le ratio S/P en % (sinistres réglés ÷ primes × 100, arrondi). Tous statuts confondus.",
      indice:
        'Partez de contrats, LEFT JOIN sinistres. Attention : SUM(prime_annuelle) serait faussé par la démultiplication des lignes — agrégez les sinistres par contrat dans une sous-requête, ou utilisez une sous-requête corrélée.',
      solution:
        "SELECT c.produit, SUM(c.prime_annuelle) AS total_primes, SUM(COALESCE(s.regle, 0)) AS total_sinistres, ROUND(SUM(COALESCE(s.regle, 0)) * 100.0 / SUM(c.prime_annuelle)) AS ratio_sp FROM contrats c LEFT JOIN (SELECT id_contrat, SUM(montant_regle) AS regle FROM sinistres WHERE montant_regle IS NOT NULL GROUP BY id_contrat) s ON s.id_contrat = c.id_contrat GROUP BY c.produit;",
    },
  ];

  // ---------------------------------------------------------------
  // Chargement paresseux des bibliothèques (sql.js + CodeMirror)
  // ---------------------------------------------------------------
  const CDN = {
    sqljs: 'https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js',
    sqljsWasmDir: 'https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/',
    cm: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.js',
    cmCss: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.css',
    cmSql: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/sql/sql.min.js',
    cmHint: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/addon/hint/show-hint.min.js',
    cmHintCss: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/addon/hint/show-hint.min.css',
    cmSqlHint: 'https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/addon/hint/sql-hint.min.js',
  };

  function chargerScript(src: string) {
    return new Promise<void>((res, rej) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => res();
      s.onerror = () => rej(new Error(`Échec de chargement : ${src}`));
      document.head.appendChild(s);
    });
  }

  function chargerCss(href: string) {
    const l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = href;
    document.head.appendChild(l);
  }

  let db: any = null;
  let editeur: any = null;
  let exoCourant: number | null = 0;
  let initLancee = false;

  async function initialiser() {
    if (initLancee) return;
    initLancee = true;
    const chargement = document.getElementById('sql-chargement')!;
    try {
      chargerCss(CDN.cmCss);
      chargerCss(CDN.cmHintCss);
      await Promise.all([chargerScript(CDN.sqljs), chargerScript(CDN.cm)]);
      await chargerScript(CDN.cmSql);
      await chargerScript(CDN.cmHint);
      await chargerScript(CDN.cmSqlHint);

      const SQL = await (window as any).initSqlJs({
        locateFile: (f: string) => CDN.sqljsWasmDir + f,
      });
      db = new SQL.Database();
      db.run(SEED);

      const CodeMirror = (window as any).CodeMirror;
      editeur = CodeMirror.fromTextArea(
        document.getElementById('sql-editeur'),
        {
          mode: 'text/x-sql',
          lineNumbers: true,
          viewportMargin: Infinity,
          extraKeys: {
            'Ctrl-Space': 'autocomplete',
            'Ctrl-Enter': executer,
            'Cmd-Enter': executer,
          },
          hintOptions: { tables: SCHEMA, completeSingle: false },
        }
      );
      // Autocomplétion au fil de la frappe
      editeur.on('inputRead', (cm: any, change: any) => {
        if (/^[a-zA-Z_.]$/.test(change.text[0]) && !cm.state.completionActive) {
          cm.showHint({ completeSingle: false });
        }
      });

      afficherSchema();
      afficherListeExos();
      choisirExo(0);

      chargement.hidden = true;
      document.getElementById('sql-atelier')!.hidden = false;
    } catch (e: any) {
      chargement.textContent = `⚠️ Impossible de charger l'atelier SQL (connexion internet requise) — ${e.message}`;
    }
  }

  // Initialisation à l'ouverture de l'onglet (ou immédiate si lien direct)
  document.addEventListener('ba:onglet', (e: any) => {
    if (e.detail === 'pratique') initialiser();
  });
  if (location.hash === '#pratique') initialiser();

  // ---------------------------------------------------------------
  // Rendu
  // ---------------------------------------------------------------
  function afficherSchema() {
    const conteneur = document.getElementById('sql-schema')!;
    conteneur.innerHTML = Object.entries(SCHEMA)
      .map(
        ([table, cols]) =>
          `<div class="table-schema"><strong>${table}</strong><span>${cols.join(', ')}</span></div>`
      )
      .join('');
  }

  function afficherListeExos() {
    const ol = document.getElementById('sql-exercices')!;
    ol.innerHTML = '';
    EXOS.forEach((exo, i) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.className = 'exo';
      btn.innerHTML = `<span class="exo-niveau">${'●'.repeat(exo.niveau)}${'○'.repeat(3 - exo.niveau)}</span> ${exo.titre} <span class="exo-etat" data-exo="${i}"></span>`;
      btn.addEventListener('click', () => choisirExo(i));
      li.appendChild(btn);
      ol.appendChild(li);
    });
    document.getElementById('sql-libre')!.addEventListener('click', () => choisirExo(null));
    majEtatsExos();
  }

  const CLE_REUSSIS = 'ba-sql-reussis';
  function lireReussis(): Set<number> {
    try {
      return new Set(JSON.parse(localStorage.getItem(CLE_REUSSIS) || '[]'));
    } catch {
      return new Set();
    }
  }

  function majEtatsExos() {
    const reussis = lireReussis();
    document.querySelectorAll<HTMLElement>('.exo-etat').forEach((e) => {
      e.textContent = reussis.has(+e.dataset.exo!) ? '✅' : '';
    });
    document.querySelectorAll<HTMLElement>('.liste-exos .exo').forEach((b, i) => {
      b.classList.toggle('exo--actif', exoCourant === i);
    });
    document
      .getElementById('sql-libre')!
      .classList.toggle('exo--actif', exoCourant === null);
  }

  function choisirExo(i: number | null) {
    exoCourant = i;
    const enonce = document.getElementById('sql-enonce')!;
    if (i === null) {
      enonce.innerHTML =
        '<h3>🧪 Bac à sable</h3><p>Requêtes libres sur la base — explorez, testez des jointures, cassez des choses : le bouton « Réinitialiser » restaure les données.</p>';
    } else {
      const exo = EXOS[i];
      enonce.innerHTML = `<h3>Exercice ${i + 1} — ${exo.titre} <span class="niveau">${'●'.repeat(exo.niveau)}${'○'.repeat(3 - exo.niveau)}</span></h3><p>${exo.enonce}</p>${exo.ordre ? '<p class="ordre">⚠️ L’ordre des lignes compte pour cet exercice.</p>' : ''}`;
    }
    document.getElementById('sql-indice-texte')!.hidden = true;
    document.getElementById('sql-verdict')!.hidden = true;
    document.getElementById('sql-attendu-bloc')!.hidden = true;
    document.getElementById('sql-resultat')!.innerHTML =
      '<p class="placeholder">Exécutez une requête pour voir le résultat.</p>';
    if (editeur) {
      editeur.setValue('');
      editeur.focus();
    }
    majEtatsExos();
  }

  function tableHtml(colonnes: string[], lignes: any[][]) {
    if (!lignes.length)
      return '<p class="placeholder">0 ligne retournée.</p>';
    const tete = colonnes.map((c) => `<th>${c}</th>`).join('');
    const corps = lignes
      .map(
        (l) =>
          `<tr>${l.map((v) => `<td>${v === null ? '<em class="nul">NULL</em>' : v}</td>`).join('')}</tr>`
      )
      .join('');
    return `<table><thead><tr>${tete}</tr></thead><tbody>${corps}</tbody></table><p class="compte">${lignes.length} ligne${lignes.length > 1 ? 's' : ''}</p>`;
  }

  function executerSql(sql: string): { columns: string[]; values: any[][] } | null {
    const res = db.exec(sql);
    if (!res.length) return { columns: [], values: [] };
    return res[res.length - 1];
  }

  function normaliserValeur(v: any) {
    if (v === null) return '␀';
    if (typeof v === 'number') return String(Math.round(v * 100) / 100);
    return String(v);
  }

  function comparer(
    obtenu: { columns: string[]; values: any[][] },
    attendu: { columns: string[]; values: any[][] },
    ordre: boolean
  ): boolean {
    if (obtenu.columns.length !== attendu.columns.length) return false;
    if (obtenu.values.length !== attendu.values.length) return false;
    const cle = (l: any[]) => l.map(normaliserValeur).join('¦');
    const a = obtenu.values.map(cle);
    const b = attendu.values.map(cle);
    if (!ordre) {
      a.sort();
      b.sort();
    }
    return a.every((x, i) => x === b[i]);
  }

  function executer() {
    if (!db || !editeur) return;
    const sql = editeur.getValue().trim();
    const zone = document.getElementById('sql-resultat')!;
    const verdict = document.getElementById('sql-verdict')!;
    const attenduBloc = document.getElementById('sql-attendu-bloc')!;
    verdict.hidden = true;
    attenduBloc.hidden = true;
    if (!sql) return;

    let resultat;
    try {
      resultat = executerSql(sql);
    } catch (e: any) {
      zone.innerHTML = `<p class="erreur">❌ Erreur SQL : ${e.message}</p>`;
      return;
    }
    zone.innerHTML = tableHtml(resultat!.columns, resultat!.values);

    // Comparaison avec le résultat attendu si un exercice est sélectionné
    if (exoCourant !== null && /^select/i.test(sql)) {
      const exo = EXOS[exoCourant];
      let attendu;
      try {
        attendu = executerSql(exo.solution)!;
      } catch {
        return;
      }
      const ok = comparer(resultat!, attendu, !!exo.ordre);
      verdict.hidden = false;
      verdict.classList.remove('verdict--ok', 'verdict--ko');
      verdict.classList.add(ok ? 'verdict--ok' : 'verdict--ko');
      if (ok) {
        verdict.innerHTML = '✅ <strong>Correct !</strong> Votre résultat correspond au résultat attendu.';
        const reussis = lireReussis();
        reussis.add(exoCourant);
        localStorage.setItem(CLE_REUSSIS, JSON.stringify([...reussis]));
        majEtatsExos();
      } else {
        verdict.innerHTML =
          '❌ <strong>Pas encore…</strong> Le résultat ne correspond pas à l’attendu (nombre de colonnes, de lignes ou valeurs). Comparez ci-dessous.';
        attenduBloc.hidden = false;
        document.getElementById('sql-attendu')!.innerHTML = tableHtml(
          attendu.columns,
          attendu.values
        );
      }
    }
  }

  document.getElementById('sql-executer')!.addEventListener('click', executer);

  document.getElementById('sql-indice')!.addEventListener('click', () => {
    if (exoCourant === null) return;
    const el = document.getElementById('sql-indice-texte')!;
    el.textContent = `💡 ${EXOS[exoCourant].indice}`;
    el.hidden = false;
  });

  document.getElementById('sql-solution')!.addEventListener('click', () => {
    if (exoCourant === null || !editeur) return;
    editeur.setValue(EXOS[exoCourant].solution);
  });

  document.getElementById('sql-reinit')!.addEventListener('click', () => {
    if (!db) return;
    db.close();
    const SQL = (window as any).initSqlJs;
    // Recréation synchrone : le module est déjà chargé, on réutilise le cache
    (window as any)
      .initSqlJs({ locateFile: (f: string) => CDN.sqljsWasmDir + f })
      .then((S: any) => {
        db = new S.Database();
        db.run(SEED);
        document.getElementById('sql-resultat')!.innerHTML =
          '<p class="placeholder">Base réinitialisée — les données d’origine sont restaurées.</p>';
      });
  });
</script>

