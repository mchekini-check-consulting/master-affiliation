---
// Page 404 minimale — les routes du site (/admissions/, /en/, …) sont
// servies par le fallback SPA de nginx, cette page ne sert qu'aux
// chemins d'assets inexistants.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page introuvable — Astonfly</title>
  </head>
  <body style="margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:#08243C; color:#fff; font-family:Archivo,system-ui,sans-serif; text-align:center;">
    <div>
      <p style="font-size:80px; font-weight:800; margin:0;">404</p>
      <p style="margin:8px 0 24px; color:#9FB3C8;">Cette page n'existe pas.</p>
      <a href="/" style="color:#00AEEF; text-decoration:none; font-weight:700;">← Retour à l'accueil</a>
    </div>
  </body>
</html>
