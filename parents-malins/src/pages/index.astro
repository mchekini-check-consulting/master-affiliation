---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Parents Malins — Astuces et bons plans pour parents"
  description="Parents Malins rassemble des astuces concrètes et des bons plans pour simplifier le quotidien des parents. Le site ouvre bientôt."
>
  <main>
    <p class="eyebrow">parents-malins.fr</p>
    <h1>Bonjour&nbsp;!</h1>
    <p class="texte">
      Parents Malins arrive bientôt&nbsp;: des astuces concrètes et des bons
      plans pour simplifier le quotidien des parents. Cette page confirme que
      le site est bien en ligne.
    </p>
  </main>

  <footer>
    <p>© 2026 parents-malins.fr</p>
  </footer>
</Layout>

<style>
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.25rem 4rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--corail);
  }

  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 7vw, 4rem);
    line-height: 1.08;
    color: var(--nuit);
  }

  .texte {
    margin: 0 auto;
    font-size: 1.1rem;
    color: var(--estompe);
    max-width: 46ch;
  }

  footer {
    text-align: center;
    padding: 2rem 1.25rem;
    font-size: 0.9rem;
    color: var(--estompe);
  }
</style>
